{
  "description": "Tell an agent running under Codello which codello commands it is expected to run, once per session, and let it run its own codello session-status, decide, and done calls without a permission prompt",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/allow-reporting.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
